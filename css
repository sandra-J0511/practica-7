/* Transición suave para el cambio de colores */
.transition-bg {
    transition: background-color 0.4s ease;
}

/* Clases personalizadas de fondo para la sección D */
.bg-custom-azul {
    background-color: #e3f2fd !important;
}

.bg-custom-verde {
    background-color: #e8f5e9 !important;
}

.bg-custom-amarillo {
    background-color: #fffde7 !important;
}